POSTGRES_DB=pongdang
POSTGRES_USER=pongdang
POSTGRES_PASSWORD=replace-with-a-random-password
HTTP_PORT=5188
APP_BASE_PATH=/
API_ROOT_PATH=
DATA_GO_KR_KEY=
KMA_API_HUB_KEY=
KAKAO_REST_KEY=
# Browser JavaScript key for map display; distinct from the server REST key.
VITE_KAKAO_MAP_KEY=
HRFCO_KEY=
COLLECTION_LATITUDE=37.8034055083
COLLECTION_LONGITUDE=128.9102102476
COLLECTION_RADIUS_M=20000
AWS_STATIONS=516
KHOA_TIDE_STATION_CODE=DT_0006
KHOA_BUOY_STATION_CODE=TW_0089
KHOA_RIP_BEACH_CODE=GYEONGPO

# Explicit source scopes (not representative mappings to the collection center).
KHOA_CURRENT_STATION_CODE=HF_0076
KHOA_CURRENT_FORECAST_CODE=16LTC10
AIR_QUALITY_STATION_NAMES=종로구
ASTRONOMY_LOCATION=서울
UV_AREA_CODE=1100000000
FORECAST_ZONE_CODE=11A00101
WATER_QUALITY_STATION_NAME=인천강화
VISITOR_STATISTICS_LAG_DAYS=60
VISITOR_REGION_CODE=
# Enable CHT only after service approval; dam adapter awaits an approved schema.
TOURISM_TRADITIONAL_ENABLED=false
DAM_RELEASE_ENABLED=false

# Existing Bonifacio SSO bridge; server-only, never a browser configuration.
SSO_PROXY_SECRET=
SSO_ALLOWED_ORIGINS=

# AI concierge: AI_API_KEY alone enables the default Luna adapter.
# Keep the existing reviewed SSO bridge configured; the key never goes to Vite.
AI_API_KEY=
AI_PROVIDER=auto
AI_MODEL=gpt-5.6-luna
AI_PRICING_MODEL=gpt-5.6-luna
# USD 0.20 input / 1.20 output per million tokens, verified 2026-09-15.
AI_INPUT_MICROUSD_PER_MILLION_TOKENS=200000
AI_OUTPUT_MICROUSD_PER_MILLION_TOKENS=1200000
AI_TIMEOUT_SECONDS=20
AI_MAX_INPUT_BYTES=65536
AI_MAX_OUTPUT_TOKENS=2048
AI_MAX_DAILY_CALLS=200
AI_MAX_DAILY_TOKENS=4000000
AI_RESERVED_CALL_MICROUSD=20000
AI_DAILY_BUDGET_MICROUSD=1000000
AI_MAX_MODEL_CALLS=3
AI_MAX_TOOL_CALLS=6
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_CONCURRENCY=2
AI_PRINCIPAL_REQUESTS_PER_MINUTE=6
# Explicit AI_PROVIDER=disabled stays disabled even when a key is present.
# Old explicit null pricing or small token limits must be reviewed, not ignored.

# On-demand water webcam catalog: server-only, no VITE_ key.
WINDY_WEBCAMS_API_KEY=
WINDY_WEBCAMS_RADII_KM=2,5,10
WINDY_WEBCAMS_DAILY_BUDGET=30
WINDY_WEBCAMS_REFRESH_HOURS=24
WINDY_WEBCAMS_TIMEOUT_SECONDS=8

# Separate explicit route requests use the same official provider as Pilgrimage.
# Route-only REST key; takes priority over legacy KAKAO_REST_KEY for routing.
# Store in this Compose directory's .env; never use a VITE/JavaScript key.
KAKAO_REST_API_KEY=
TRAVEL_ROUTE_PROVIDER=kakao
