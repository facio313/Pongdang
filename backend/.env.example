POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=pongdang
POSTGRES_USER=pongdang
POSTGRES_PASSWORD=replace-with-a-random-password
API_ROOT_PATH=
DATA_GO_KR_KEY=
# Photos: defaults to <checkout>/.local/attachments for direct Python processes.
# Use the same absolute override for backend and collector, if needed.
# ATTACHMENT_ROOT=/absolute/path/to/pongdang/attachments
PHOTO_COLLECTION_ENABLED=true
PHOTO_COLLECTION_BATCH_SIZE=25
# Photos follow persisted detail revisions; no periodic metadata refresh.
PHOTO_MAX_BYTES=8388608
KMA_API_HUB_KEY=
KAKAO_REST_KEY=
HRFCO_KEY=
COLLECTION_LATITUDE=37.8034055083
COLLECTION_LONGITUDE=128.9102102476
COLLECTION_RADIUS_M=20000
# Province-wide tourism catalog; existing observation source scopes stay explicit.
TOURISM_COLLECTION_SCOPE=gangwon
TOURISM_PAGES_PER_RUN=5
# Existing/new places: persist details once; recheck only on source revision.
# Request cap per TourAPI service/Korean calendar day (other jobs are separate).
PLACE_DETAIL_COLLECTION_ENABLED=true
PLACE_DETAIL_BATCH_SIZE=10
PLACE_DETAIL_DAILY_BUDGET=500
AWS_STATIONS=516

# Authenticated APIs require the existing reviewed Bonifacio SSO bridge.
SSO_PROXY_SECRET=
SSO_ALLOWED_ORIGINS=
NOTIFICATIONS_PROVIDER=disabled
NOTIFICATIONS_RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL=
NOTIFICATIONS_DELIVERY_ENABLED=false
LIVECAM_ALLOWED_HOSTS=
# Windy representative thumbnails are saved once, separately from place photos.
# Default: <checkout>/.local/windy-thumbnails; Compose uses a persistent volume.
# WINDY_THUMBNAIL_ROOT=/absolute/path/to/pongdang/windy-thumbnails
# AI concierge: AI_API_KEY alone enables the default Luna adapter.
# Keep the existing reviewed SSO bridge configured; the key never goes to Vite.
AI_API_KEY=
AI_PROVIDER=auto
AI_MODEL=gpt-5.6-luna
AI_PRICING_MODEL=gpt-5.6-luna
# USD 0.20 input / 1.20 output per million tokens, verified 2026-09-15.
AI_INPUT_MICROUSD_PER_MILLION_TOKENS=200000
AI_OUTPUT_MICROUSD_PER_MILLION_TOKENS=1200000
AI_TIMEOUT_SECONDS=20
AI_MAX_INPUT_BYTES=65536
AI_MAX_OUTPUT_TOKENS=2048
AI_MAX_DAILY_CALLS=200
AI_MAX_DAILY_TOKENS=4000000
AI_RESERVED_CALL_MICROUSD=20000
AI_DAILY_BUDGET_MICROUSD=1000000
AI_MAX_MODEL_CALLS=3
AI_MAX_TOOL_CALLS=6
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_CONCURRENCY=2
AI_PRINCIPAL_REQUESTS_PER_MINUTE=6
# Explicit AI_PROVIDER=disabled stays disabled even when a key is present.
# Old explicit null pricing or small token limits must be reviewed, not ignored.

# Explicit source scopes (not representative mappings to the collection center).
KHOA_CURRENT_STATION_CODE=HF_0076
KHOA_CURRENT_FORECAST_CODE=16LTC10
AIR_QUALITY_STATION_NAMES=종로구
ASTRONOMY_LOCATION=서울
UV_AREA_CODE=1100000000
FORECAST_ZONE_CODE=11A00101
WATER_QUALITY_STATION_NAME=인천강화
VISITOR_STATISTICS_LAG_DAYS=60
VISITOR_REGION_CODE=
# Enable CHT only after service approval; dam adapter awaits an approved schema.
TOURISM_TRADITIONAL_ENABLED=false
DAM_RELEASE_ENABLED=false

# Stored water webcam catalog: key for first import/manual refresh, never VITE_.
WINDY_WEBCAMS_API_KEY=
WINDY_WEBCAMS_RADII_KM=2,5,10
WINDY_WEBCAMS_DAILY_BUDGET=30
# Applies only to explicit nearby searches, not automatic catalog refresh.
WINDY_WEBCAMS_REFRESH_HOURS=24
WINDY_WEBCAMS_TIMEOUT_SECONDS=8

# Route-only REST key; takes priority over legacy KAKAO_REST_KEY for routing.
# Direct backend runs read backend/.env; Compose reads the root .env.
KAKAO_REST_API_KEY=
TRAVEL_ROUTE_PROVIDER=kakao
